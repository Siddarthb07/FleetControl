# Fleet Control — change token before any non-loopback bind
FLEET_TOKEN=dev-change-me
FLEET_CONTROL_HOST=127.0.0.1
FLEET_CONTROL_PORT=8787
FLEET_PRESET=pool-7b
FLEET_STARTING_DEADLINE_SEC=15

# Dual mode: preset runtime wins. Optional global default: stub | anima
# FLEET_RUNTIME=stub

